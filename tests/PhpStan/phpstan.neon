parameters:
    ignoreErrors:
        - identifier: missingType.iterableValue
        - '#Access to an undefined property OxidEsales\\Eshop\\Application\\Model\\Order::\$oxorder__oxbillfname#'
        - '#Access to an undefined property OxidEsales\\Eshop\\Application\\Model\\Order::\$oxorder__oxbilllname#'
        - '#Access to an undefined property OxidEsales\\Eshop\\Application\\Model\\Shop::\$oxshops__oxname#'
    bootstrapFiles:
        - phpstan-bootstrap.php
    stubFiles:
        - stubs/OrderController.stub
        - stubs/OrderArticleController.stub
        - stubs/OrderListController.stub
        - stubs/AddressModel.stub
        - stubs/CountryModel.stub
        - stubs/UserModel.stub
        - stubs/OrderModel.stub
        - stubs/PaymentController.stub
        - stubs/PaymentGatewayModel.stub
        - stubs/PaymentModel.stub
        - stubs/ViewConfig.stub
        - stubs/Email.stub
    level: max
    scanFiles:
        - ../../vendor/oxid-esales/oxideshop-ce/source/oxfunctions.php
        - ../../vendor/oxid-esales/oxideshop-ce/source/overridablefunctions.php
